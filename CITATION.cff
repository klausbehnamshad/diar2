    family-names: Behnam Shad
    orcid: "https://orcid.org/0000-0002-3601-9024"
repository-code: "https://github.com/klausbehnamshad/diar2"
license: Apache-2.0
version: 0.1.0
date-released: "2026-09-30"
keywords:
  - oral history
  - speaker diarization
  - transcription
  - digital humanities
